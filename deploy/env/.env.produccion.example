# =============================================================================
# BAMX backend - configuracion de PRODUCCION
# =============================================================================
# Este archivo se copia a C:\BAMX\app\.env y se rellena con los valores REALES
# que reporto 00-preflight.ps1. NUNCA se sube a git.
#
# TRES REGLAS QUE ROMPEN EL ARRANQUE SI SE IGNORAN:
#
#   1. Las rutas van con diagonal normal "/", NUNCA con "\".
#      Spring lee este archivo como .properties, donde "\" es caracter de
#      escape. "C:/Program Files (x86)/..." OK / "C:\Program Files..." MAL.
#
#   2. APP_IMAGES_PATH TIENE que terminar en "/". El codigo concatena
#      literalmente (imagesPath + cveArt + ".jpg") en FotoInveController.
#
#   3. Ninguna variable sin valor por default puede faltar. Si falta una,
#      Spring no resuelve el placeholder y la app no arranca.
#
# El archivo se lee relativo al DIRECTORIO DE TRABAJO del proceso. Por eso el
# XML de WinSW fija <workingdirectory>%BASE%</workingdirectory>: para que el
# servicio arranque en C:\BAMX\app y encuentre este .env.
# =============================================================================


# --- Seguridad -------------------------------------------------------------
# GENERAR UNO NUEVO PARA PRODUCCION. No reusar el de desarrollo.
#   powershell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# Minimo 32 bytes. Si cambia, todas las sesiones activas se invalidan.
JWT_SECRET=CAMBIAR_ESTE_VALOR_POR_UNO_ALEATORIO_DE_AL_MENOS_32_BYTES

# Milisegundos. 600000 = 10 minutos.
ACCESS_TOKEN_EXPIRATION=600000
# Milisegundos. 2592000000 = 30 dias.
REFRESH_TOKEN_EXPIRATION=2592000000


# --- Aplicacion ------------------------------------------------------------
# OBLIGATORIA aunque hoy ningun @Value la lea: el placeholder sin default
# revienta el arranque si falta. Poner la IP FIJA de esta computadora.
APP_HOST_URL=http://192.168.1.100:8080

# Carpeta de imagenes de producto de Aspel. CON "/" AL FINAL.
APP_IMAGES_PATH=C:/Program Files (x86)/Common Files/Aspel/Sistemas Aspel/SAE8.00/Empresa03/Imagenes/

# Sufijo de empresa de Aspel. Lo confirma el paso 9 del preflight.
# NO asumir "03": depende de como este configurada la instalacion de BAMX.
APP_EMPRESA_SUFFIX=03


# --- Base de datos: EMPRESA (inventario de Aspel, solo lectura) ------------
DATABASE_HOST_EMPRESA=localhost
DATABASE_PORT_EMPRESA=3050
DATABASE_PATH_EMPRESA=C:/Program Files (x86)/Common Files/Aspel/Sistemas Aspel/SAE8.00/Empresa03/Datos/SAE80EMPRE03.FDB
DATABASE_USERNAME_EMPRESA=sysdba
DATABASE_PASSWORD_EMPRESA=masterkey


# --- Base de datos: AUTH (usuarios de la app) ------------------------------
DATABASE_HOST_AUTH=localhost
DATABASE_PORT_AUTH=3050
DATABASE_PATH_AUTH=C:/Program Files (x86)/Common Files/Aspel/Perfiles/BAMX_PERFILES.FDB
DATABASE_USERNAME_AUTH=sysdba
DATABASE_PASSWORD_AUTH=masterkey


# --- Opcionales ------------------------------------------------------------
# Descomentar SOLO si el puerto 8080 ya esta ocupado en esta maquina.
# Si se cambia, hay que ajustar tambien APP_HOST_URL, la regla de firewall
# y EXPO_PUBLIC_API_URL del APK.
#SERVER_PORT=8081

# =============================================================================
# Frontend (Expo). Copiar a .env y ajustar.
# =============================================================================
# CUIDADO: las EXPO_PUBLIC_* se INLINEAN en tiempo de bundle. El valor queda
# quemado dentro del APK. Cambiarlas exige recompilar y reinstalar la app en
# cada tablet; no basta con reiniciar nada.
# =============================================================================

# En desarrollo: la IP de LAN de la maquina que corre el backend (NO localhost,
# el emulador y el telefono no lo resuelven).
# En el APK de BAMX: la IP FIJA de la computadora donde corre el servicio.
# Fijarla con reserva DHCP en el router ANTES de compilar.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8080

EXPO_PUBLIC_ENV=development

# --- MQTT (refrigeradores) --------------------------------------------------
# OJO con el APK de produccion: si estas variables no estan definidas,
# useTemperatureSensors cae a defaults hardcodeados que apuntan a
# broker.hivemq.com, un broker PUBLICO de internet. La app se suscribiria a
# bamx/sensors/temperature ahi y mostraria lecturas de cualquier desconocido.
# No filtra datos de BAMX (solo se suscribe), pero es basura en pantalla.
#
# Mientras no haya hardware de sensores instalado, dejar un valor inalcanzable
# a proposito para que la pantalla quede vacia en vez de mostrar ruido ajeno.
EXPO_PUBLIC_MQTT_BROKER_URL=wss://localhost:1883/mqtt
EXPO_PUBLIC_MQTT_USERNAME=user
EXPO_PUBLIC_MQTT_PASSWORD=password

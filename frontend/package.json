{
  "name": "bamx",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --ci --runInBand --passWithNoTests --detectOpenHandles --coverage",
    "tests": "jest --watchAll"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/drawer": "^7.5.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@reduxjs/toolkit": "^2.2.7",
    "@shopify/react-native-skia": "2.2.12",
    "@testing-library/react-native": "^13.3.3",
    "axios": "^1.7.7",
    "buffer": "^6.0.3",
    "expo": "~54.0.34",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "mqtt": "^5.14.1",
    "nativewind": "^4.1.23",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "process": "^0.11.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.53.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "react-redux": "^9.2.0",
    "victory-native": "^41.19.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/__tests__/setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|@react-native|@react-navigation|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-native-community|@expo/vector-icons|react-redux|@reduxjs/toolkit|immer)"
    ],
    "collectCoverageFrom": [
      "components/**/*.{ts,tsx}",
      "screens/**/*.{ts,tsx}",
      "!**/__tests__/**",
      "!**/node_modules/**"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/__tests__/setup.ts",
      "<rootDir>/__tests__/utils/"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.4",
    "typescript": "~5.9.2"
  },
  "private": true
}
